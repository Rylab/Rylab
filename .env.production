# Do not check-in actual values to this file!
# Store real values in `.env.local` to override values here for production builds,
# or replace this file from a secure personal template during your CI runs

# Please actually change this in your real environment!
MANAGE_PASS=PASSWORD_ROFL

# Keep synced with port used by `next start` script in package.json
NEXT_PUBLIC_BASE_PORT=3000

# When running behind an SSL proxy, set this to true (default: false)
NEXT_PUBLIC_SECURE_PROXY=true

# Do not add 'http://' style prefix or a suffix slash, e.g.
# www.rylab.dev or rylab.lox -- NOT https://www.rylab.com/
NEXT_PUBLIC_BASE_URI=127.0.0.1

# Optional Hanko API URL (for authentication in production)
# NEXT_PUBLIC_HANKO_API_URL=https://your-hanko-api-url.com
